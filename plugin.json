{
  "apiVersion": 1,
  "requires": {
    "pluginApi": "3.7.0"
  },
  "id": "eidos.smart-actions",
  "name": "%plugin.name%",
  "version": "0.4.0",
  "icon": {
    "paths": [
      "M12 3v4m0 10v4M3 12h4m10 0h4M6 6l3 3m6 6 3 3M6 18l3-3m6-6 3-3"
    ]
  },
  "extension": "./src/extension.ts",
  "views": [
    {
      "id": "configure",
      "title": "%views.configure.title%",
      "entry": "./src/settings.ts",
      "access": "write",
      "kind": "file",
      "capabilities": [
        "eidos/schema",
        "eidos/config"
      ]
    }
  ],
  "actions": [
    {
      "id": "smart-actions",
      "title": "%actions.smart-actions.title%",
      "context": "table",
      "access": "write"
    }
  ],
  "placements": [
    {
      "location": "table/context",
      "action": "smart-actions"
    },
    {
      "location": "file/open",
      "view": "configure",
      "extensions": [
        ".eidos"
      ]
    }
  ],
  "connections": {
    "action-generator": {
      "title": "%connections.action-generator.title%",
      "url": "https://api.openai.com/v1/chat/completions",
      "configurable": true
    },
    "typesafe-default": {
      "title": "%connections.typesafe-default.title%",
      "url": "https://api.typesafe.ai/v1/systemone"
    }
  },
  "description": "%plugin.description%",
  "i18n": {
    "defaultLocale": "en",
    "messages": {
      "en": "./locales/en.json",
      "zh-CN": "./locales/zh-CN.json"
    },
    "readme": {
      "en": "./README.md",
      "zh-CN": "./README.zh-CN.md"
    }
  }
}
